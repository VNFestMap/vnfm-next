SERVER_PORT=3711
SERVER_MODE=dev

# Empty: API still boots; /healthz does not need Postgres.
# postgres://user:pass@127.0.0.1:5432/vnfm?sslmode=disable
DATABASE_URL=

CORS_ALLOW_ORIGINS=http://127.0.0.1:3710

# Public OIDC issuer (no Docker DNS, no S2S).
OIDC_ISSUER=https://account.nextmoe.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://127.0.0.1:3710/auth/callback

# Cloudflare R2 (S3 API). Leave empty until uploads land.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=vnfm
R2_ENDPOINT=
R2_PUBLIC_BASE=
