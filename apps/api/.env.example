SERVER_PORT=3711
SERVER_MODE=dev

# Host Postgres used by the nextmoe-infra dev box (user postgres / password 191007).
DATABASE_URL=postgresql://postgres:191007@127.0.0.1:5432/vnfm?sslmode=disable

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

CORS_ALLOW_ORIGINS=http://127.0.0.1:3710

# Public OIDC (no Docker DNS, no S2S). Dev client is inserted into kun_galgame_infra.oauth_clients.
OIDC_ISSUER=http://127.0.0.1:9277
OIDC_SERVER_URL=http://127.0.0.1:9277/api/v1
OIDC_FRONTEND_URL=http://127.0.0.1:9420
OIDC_CLIENT_ID=vnfm-dev
OIDC_CLIENT_SECRET=dev-secret-vnfm-dev
OIDC_REDIRECT_URI=http://127.0.0.1:3710/auth/callback

# Cloudflare R2 (S3 API). Leave empty until uploads land.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=vnfm
R2_ENDPOINT=
R2_PUBLIC_BASE=
